# Model API Keys
# Tier 1 (cheap model) & Tier 2 (large model)
# Choose your providers (OpenAI, Google Gemini, Anthropic, Groq, etc.)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Provider Configuration
TIER1_PROVIDER=openai
TIER1_MODEL=gpt-4o-mini
TIER2_PROVIDER=openai
TIER2_MODEL=gpt-4o

# Environment Settings
APP_ENV=development
LOG_LEVEL=INFO
