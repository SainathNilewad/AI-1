# Groq LLM API Configuration (Hinglish Query Understanding)
GROQ_API_KEY=your_groq_api_key_here

# Model Cascade Pair (Groq)
TIER1_PROVIDER=groq
TIER1_MODEL=openai/gpt-oss-20b
TIER2_PROVIDER=groq
TIER2_MODEL=openai/gpt-oss-120b

# Real Estate Property Listing API Configuration
# Options for REAL_ESTATE_API_PROVIDER:
#   - 'local'   : Uses built-in verified Indian property catalog (Data/properties.json, 148 listings)
#   - 'rentcast': Connects to RentCast REST API (https://api.rentcast.io)
#   - 'auto'    : Uses live API if REAL_ESTATE_API_KEY is present, otherwise falls back to local
REAL_ESTATE_API_PROVIDER=local
REAL_ESTATE_API_KEY=your_real_estate_api_key_here
# Optional custom endpoint (defaults to standard RentCast rental & sale endpoints):
# REAL_ESTATE_API_BASE_URL=https://api.rentcast.io/v1/listings/rental/long-term

# Environment Settings
APP_ENV=development
LOG_LEVEL=INFO
